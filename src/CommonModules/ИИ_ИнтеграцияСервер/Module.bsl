#Область ПрограммныйИнтерфейс

// Отправляет вопрос в GigaChat.
//
// Параметры:
//  ТекстВопроса   - Строка
//  СистемныйПромпт - Строка
//  Температура    - Число - для извлечения данных лучше 0..0.1
//  Модель         - Строка
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Текст (Строка), Ошибка (Строка)
//
Функция СпроситьGigaChat(ТекстВопроса, СистемныйПромпт = "Ты полезный ассистент внутри системы 1С.", Температура = 0.1, Модель = "GigaChat") Экспорт
	
	Результат = Новый Структура("Успех, Текст, Ошибка", Ложь, "", "");
	
	Сообщения = Новый Массив;
	Если ЗначениеЗаполнено(СистемныйПромпт) Тогда
		Сообщения.Добавить(Новый Структура("role, content", "system", СистемныйПромпт));
	КонецЕсли;
	Сообщения.Добавить(Новый Структура("role, content", "user", ТекстВопроса));
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("model", Модель);
	ПараметрыЗапроса.Вставить("messages", Сообщения);
	ПараметрыЗапроса.Вставить("temperature", Температура);
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ПараметрыЗапроса);
	ТелоЗапроса = Запись.Закрыть();
	
	ОписаниеОшибки = "";
	
	// Две попытки: если сервер вернул 401, обновляем токен и повторяем один раз.
	Для НомерПопытки = 1 По 2 Цикл
		
		Токен = ПолучитьАктуальныйТокенGigaChat(НомерПопытки = 2);
		Если Не ЗначениеЗаполнено(Токен) Тогда
			Результат.Ошибка = "Не удалось получить токен авторизации GigaChat. Проверьте настройки и журнал регистрации.";
			Возврат Результат;
		КонецЕсли;
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json");
		Заголовки.Вставить("Accept", "application/json");
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		
		Ответ = ВыполнитьHTTPЗапрос("gigachat.devices.sberbank.ru", "/api/v1/chat/completions", "POST", ТелоЗапроса, Заголовки);
		
		Если Ответ = Неопределено Тогда
			ОписаниеОшибки = "Нет ответа от сервера";
			Прервать;
		КонецЕсли;
		
		Если Ответ.КодСостояния = 401 И НомерПопытки = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Если Ответ.КодСостояния = 200 Тогда
			ТекстОтвета = ИзвлечьТекстИзОтветаGigaChat(Ответ.Тело);
			Если ТекстОтвета <> Неопределено Тогда
				Результат.Успех = Истина;
				Результат.Текст = ТекстОтвета;
				Возврат Результат;
			КонецЕсли;
			ОписаниеОшибки = "Не удалось разобрать ответ: " + Лев(Ответ.Тело, 500);
		ИначеЕсли Ответ.КодСостояния = 429 Тогда
			ОписаниеОшибки = "Превышен лимит запросов (429). Повторите позже.";
		Иначе
			ОписаниеОшибки = "Код: " + Ответ.КодСостояния + " " + Лев(Ответ.Тело, 500);
		КонецЕсли;
		
		Прервать;
		
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("ИИ_GigaChat.ОшибкаЗапроса", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки);
	Результат.Ошибка = "Ошибка при обращении к GigaChat: " + ОписаниеОшибки;
	Возврат Результат;
	
КонецФункции

// Извлекает из произвольного текста данные в виде JSON по заданной схеме.
//
// Параметры:
//  Текст        - Строка - исходный текст (например, ответ другого API)
//  ОписаниеСхемы - Строка - описание JSON-схемы, которую нужно вернуть
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Данные (Соответствие), Ошибка (Строка)
//
Функция ИзвлечьДанныеИзТекста(Текст, ОписаниеСхемы) Экспорт
	
	Результат = Новый Структура("Успех, Данные, Ошибка", Ложь, Неопределено, "");
	
	Промпт = "Извлеки данные из текста пользователя и верни ТОЛЬКО валидный JSON без пояснений и без markdown. "
		+ "Схема: " + ОписаниеСхемы + " "
		+ "Если данных в тексте нет, ставь null. Ничего не выдумывай.";
	
	Ответ = СпроситьGigaChat(Текст, Промпт, 0);
	Если Не Ответ.Успех Тогда
		Результат.Ошибка = Ответ.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	// Оставляем только часть от первой "{" до последней "}" - это надёжнее, чем вырезать ```json.
	Строка = Ответ.Текст;
	Начало = СтрНайти(Строка, "{");
	Конец = 0;
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Если Сред(Строка, Позиция, 1) = "}" Тогда
			Конец = Позиция;
		КонецЕсли;
	КонецЦикла;
	
	Если Начало = 0 Или Конец <= Начало Тогда
		Результат.Ошибка = "GigaChat вернул ответ без JSON: " + Лев(Строка, 500);
		Возврат Результат;
	КонецЕсли;
	
	Строка = Сред(Строка, Начало, Конец - Начало + 1);
	
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Строка);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Результат.Ошибка = "GigaChat вернул невалидный JSON: " + Лев(Строка, 500);
		ЗаписьЖурналаРегистрации("ИИ_GigaChat.НевалидныйJSON", УровеньЖурналаРегистрации.Ошибка, , , Результат.Ошибка);
		Возврат Результат;
	КонецПопытки;
	
	Результат.Успех = Истина;
	Результат.Данные = Данные;
	Возврат Результат;
	
КонецФункции

// Универсальная функция для выполнения HTTPS-запросов.
// Возвращает Структуру (КодСостояния, Тело) или Неопределено при сбое соединения.
Функция ВыполнитьHTTPЗапрос(АдресСервера, Ресурс, Метод = "GET", ТелоЗапроса = "", Заголовки = Неопределено, Порт = 443) Экспорт
	
	Попытка
		Соединение = Новый HTTPСоединение(АдресСервера, Порт, , , , 30, ПолучитьЗащищенноеСоединение());
		
		Запрос = Новый HTTPЗапрос(Ресурс);
		Если Заголовки <> Неопределено Тогда
			Для Каждого Элемент Из Заголовки Цикл
				Запрос.Заголовки.Вставить(Элемент.Ключ, Элемент.Значение);
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
		КонецЕсли;
		
		Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
		
		Результат = Новый Структура;
		Результат.Вставить("КодСостояния", Ответ.КодСостояния);
		Результат.Вставить("Тело", Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
		Возврат Результат;
		
	Исключение
		ЗаписьЖурналаРегистрации("ИИ_Интеграция.ОшибкаHTTP", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибкиДляЖурнала(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает актуальный токен. При ПринудительноОбновить = Истина кэш игнорируется.
Функция ПолучитьАктуальныйТокенGigaChat(ПринудительноОбновить = Ложь)
	
	Если Не ПринудительноОбновить Тогда
		ТекущийТокен = Константы.ИИ_GigaChat_AccessToken.Получить();
		ДатаИстечения = Константы.ИИ_GigaChat_TokenExpiresAt.Получить(); // хранится в UTC
		
		Если ЗначениеЗаполнено(ТекущийТокен) И ДатаИстечения > (ТекущаяУниверсальнаяДата() + 120) Тогда
			Возврат ТекущийТокен;
		КонецЕсли;
	КонецЕсли;
	
	КлючАвторизации = СокрЛП(Константы.ИИ_GigaChat_AuthorizationKey.Получить());
	ОбластьДействия = СокрЛП(Константы.ИИ_GigaChat_Scope.Получить());
	Если Не ЗначениеЗаполнено(ОбластьДействия) Тогда
		ОбластьДействия = "GIGACHAT_API_PERS";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КлючАвторизации) Тогда
		ЗаписьЖурналаРегистрации("ИИ_GigaChat.ОшибкаАвторизации", УровеньЖурналаРегистрации.Ошибка, , , "Не заполнен Authorization Key в константах.");
		Возврат "";
	КонецЕсли;
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("RqUID", Строка(Новый УникальныйИдентификатор));
	Заголовки.Вставить("Authorization", "Basic " + КлючАвторизации);
	
	ТелоЗапроса = "scope=" + ОбластьДействия;
	
	Ответ = ВыполнитьHTTPЗапрос("ngw.devices.sberbank.ru", "/api/v2/oauth", "POST", ТелоЗапроса, Заголовки, 9443);
	
	Если Ответ <> Неопределено И Ответ.КодСостояния = 200 Тогда
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(Ответ.Тело);
			Данные = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
			
			НовыйТокен = Данные.Получить("access_token");
			ВремяИстеченияМс = Данные.Получить("expires_at");
			
			Если ЗначениеЗаполнено(НовыйТокен) И ВремяИстеченияМс <> Неопределено Тогда
				// expires_at - Unix-время в миллисекундах (UTC).
				ДатаОкончания = Дата(1970, 1, 1, 0, 0, 0) + Цел(ВремяИстеченияМс / 1000);
				
				Константы.ИИ_GigaChat_AccessToken.Установить(НовыйТокен);
				Константы.ИИ_GigaChat_TokenExpiresAt.Установить(ДатаОкончания);
				
				Возврат НовыйТокен;
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ИИ_GigaChat.ОшибкаТокена", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат "";
		КонецПопытки;
	КонецЕсли;
	
	ОписаниеОшибки = ?(Ответ <> Неопределено, "Код: " + Ответ.КодСостояния + " " + Лев(Ответ.Тело, 500), "Нет ответа от сервера авторизации");
	ЗаписьЖурналаРегистрации("ИИ_GigaChat.ОшибкаТокена", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки);
	
	Возврат "";
	
КонецФункции

// Достаёт текст ответа модели из тела ответа API. Возвращает Неопределено, если не удалось.
Функция ИзвлечьТекстИзОтветаGigaChat(ТелоОтвета)
	
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		
		Варианты = Данные.Получить("choices");
		Если Варианты <> Неопределено И Варианты.Количество() > 0 Тогда
			Сообщение = Варианты[0].Получить("message");
			Если Сообщение <> Неопределено Тогда
				Содержимое = Сообщение.Получить("content");
				Если Содержимое <> Неопределено Тогда
					Возврат Содержимое;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ИИ_GigaChat.ОшибкаРазбора", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибкиДляЖурнала(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

// Создаёт защищённое соединение. Если задан путь к сертификату НУЦ Минцифры - использует его.
Функция ПолучитьЗащищенноеСоединение()
	
	// Укажите путь к файлу корневого сертификата НУЦ Минцифры на сервере 1С
	// (например, "/etc/ssl/certs/russian_trusted_root_ca.crt" или "C:\certs\russian_trusted_root_ca.crt").
	// Если сертификат уже установлен в хранилище ОС сервера, оставьте пустую строку.
	ПутьКСертификату = "";
	
	Если ЗначениеЗаполнено(ПутьКСертификату) Тогда
		СертификатыУЦ = Новый СертификатыУдостоверяющихЦентровФайл(ПутьКСертификату);
		Возврат Новый ЗащищенноеСоединениеOpenSSL(Неопределено, СертификатыУЦ);
	КонецЕсли;
	
	Возврат Новый ЗащищенноеСоединениеOpenSSL();
	
КонецФункции

// Формирует подробный текст ошибки из ИнформацияОбОшибке, включая вложенные причины.
Функция ТекстОшибкиДляЖурнала(ИнфоОбОшибке)
	
	Текст = ИнфоОбОшибке.Описание;
	
	Если ЗначениеЗаполнено(ИнфоОбОшибке.ИмяМодуля) Тогда
		Текст = Текст + Символы.ПС + "Модуль: " + ИнфоОбОшибке.ИмяМодуля
			+ ", строка " + Формат(ИнфоОбОшибке.НомерСтроки, "ЧГ=0");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнфоОбОшибке.ИсходнаяСтрока) Тогда
		Текст = Текст + Символы.ПС + "Код: " + СокрЛП(ИнфоОбОшибке.ИсходнаяСтрока);
	КонецЕсли;
	
	Если ИнфоОбОшибке.Причина <> Неопределено Тогда
		Текст = Текст + Символы.ПС + "Причина: " + ТекстОшибкиДляЖурнала(ИнфоОбОшибке.Причина);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

#КонецОбласти