#Область ПрограммныйИнтерфейс

Функция ОтветитьНаВопросПоБазе(ВопросПользователя, ТолькоЧтение = Ложь) Экспорт
	
	Результат = Новый Структура("Успех, Текст, Ошибка", Ложь, "", "");
	
	Попытка
		Намерение = РаспознатьНамерение(ВопросПользователя);
		Действие = ?(Намерение <> Неопределено, Намерение.Получить("действие"), Неопределено);
		
		// Команда изменения данных — выполняем сразу
		Если ЗначениеЗаполнено(Действие) И Действие <> "null" Тогда
			Если ТолькоЧтение Тогда
				Результат.Успех = Истина;
				Результат.Текст = "⛔ У вашего ключа доступа права «Только чтение». Изменение, добавление и удаление данных запрещено.";
				Возврат Результат;
			КонецЕсли;
			
			Результат.Успех = Истина;
			Результат.Текст = ВыполнитьКомандуЗаписи(Намерение);
			Возврат Результат;
		КонецЕсли;
		
		ПланЗапроса = Неопределено;
		Если Намерение <> Неопределено И ТипЗнч(Намерение.Получить("разделы")) = Тип("Соответствие") Тогда
			ПланЗапроса = Намерение.Получить("разделы");
		КонецЕсли;
		
		Если ПланЗапроса = Неопределено Тогда
			ПланЗапроса = Новый Соответствие;
			ПланЗапроса.Вставить("общая_сводка", Истина);
		КонецЕсли;
		
		КонтекстБазы = СобратьКонтекстИзБазы(ПланЗапроса);
		КартаКонфигурации = ПолучитьКартуКонфигурации();
		
		СистемныйПромпт = "Ты умный аналитик и помощник руководителя в 1С:Мини-Ферма. "
			+ "Отвечай строго на основе переданных данных и структуры конфигурации базы 1С. "
			+ "Если каких-то данных нет, честно скажи об этом, не выдумывай цифры. "
			+ "Отвечай структурированно, понятно и по делу.";
		
		ПолныйЗапрос = "Вопрос пользователя: " + ВопросПользователя + Символы.ПС + Символы.ПС
			+ "Структура конфигурации 1С (метаданные):" + Символы.ПС
			+ КартаКонфигурации + Символы.ПС + Символы.ПС
			+ "Актуальные данные из базы 1С на " + Формат(ТекущаяДатаСеанса(), "ДЛФ=ДТ") + ":" + Символы.ПС
			+ КонтекстБазы;
		
		Возврат ИИ_ИнтеграцияСервер.СпроситьGigaChat(ПолныйЗапрос, СистемныйПромпт, 0.2);
		
	Исключение
		ТекстОшибки = ТекстОшибкиДляЖурнала(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ИИ_Аналитика.Ошибка", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		Результат.Ошибка = "Ошибка при работе с базой: " + ТекстОшибки;
		Возврат Результат;
	КонецПопытки;
	
КонецФункции


#КонецОбласти

#Область УправлениеДанными

// ЕДИНЫЙ маршрутизатор: один запрос к API определяет и действие, и разделы, и реквизиты
Функция РаспознатьНамерение(ТекстПользователя)
	
	КартаКонфигурации = ПолучитьКартуКонфигурации();
	
	Схема = "{"
		+ """действие"": ""добавить"" или ""обновить"" или ""удалить"" или null, "
		+ """объект"": ""полное имя объекта метаданных (например Справочник.Животные, Документ.ПриходКорма, РегистрСведений.Цены) или null"", "
		+ """реквизиты"": { ""ИмяРеквизита"": значение, ... } или null, "
		+ """отбор"": { ""ИмяРеквизита"": значение, ... } или null, "
		+ """разделы"": {"
			+ """виды_животных"": true/false, "
			+ """животные_список"": true/false, "
			+ """поголовье"": true/false, "
			+ """корма"": true/false, "
			+ """продукция"": true/false, "
			+ """общая_сводка"": true/false"
		+ "}"
		+ "}";
	
	Промпт = "Ты — маршрутизатор запросов к базе 1С:Мини-Ферма. "
		+ "Ниже — полная карта конфигурации:" + Символы.ПС
		+ КартаКонфигурации + Символы.ПС + Символы.ПС
		+ "Проанализируй запрос пользователя и верни JSON по схеме." + Символы.ПС
		+ "1) Если пользователь просит ДОБАВИТЬ, ИЗМЕНИТЬ или УДАЛИТЬ данные — заполни 'действие', 'объект' (точное полное имя из карты) и 'реквизиты'/'отбор'. "
		+ "Разделы поставь в false. Для удаления/обновления в 'отбор' укажи ключевые поля (Наименование, Код, Номер и т.п.)." + Символы.ПС
		+ "2) Важно: для изменения остатков или оборотов используй соответствующий ДОКУМЕНТ (если он есть), а не РегистрНакопления напрямую." + Символы.ПС
		+ "3) Если это обычный вопрос, отчёт или запрос структуры конфигурации — действие = null, отметь true в нужных полях 'разделы'." + Символы.ПС
		+ "Запрос: " + ТекстПользователя;
	
	ОтветИИ = ИИ_ИнтеграцияСервер.ИзвлечьДанныеИзТекста(Промпт, Схема);
	Если ОтветИИ.Успех Тогда
		Возврат ОтветИИ.Данные;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции



// Универсальный исполнитель команд записи для ЛЮБОГО объекта конфигурации
Функция ВыполнитьКомандуЗаписи(Команда)
	
	Действие = НРег(СокрЛП(Строка(Команда.Получить("действие"))));
	ИмяОбъекта = СокрЛП(Строка(Команда.Получить("объект")));
	
	Если Не ЗначениеЗаполнено(ИмяОбъекта) Или ИмяОбъекта = "null" Тогда
		Возврат "Не удалось определить объект метаданных. Уточните, что именно нужно изменить (например: «Добавь кролика по кличке Пушок в справочник Животные»).";
	КонецЕсли;
	
	ОбъектМД = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
	Если ОбъектМД = Неопределено Тогда
		Возврат "Объект «" + ИмяОбъекта + "» не найден в конфигурации. Проверьте имя.";
	КонецЕсли;
	
	Реквизиты = Команда.Получить("реквизиты");
	Отбор = Команда.Получить("отбор");
	
	Если Действие = "добавить" Тогда
		Возврат ДобавитьОбъект(ОбъектМД, Реквизиты);
	ИначеЕсли Действие = "обновить" Тогда
		Возврат ОбновитьОбъект(ОбъектМД, Отбор, Реквизиты);
	ИначеЕсли Действие = "удалить" Тогда
		Возврат УдалитьОбъект(ОбъектМД, Отбор);
	КонецЕсли;
	
	Возврат "Неизвестная команда: " + Действие;
	
КонецФункции


// ---------- Универсальные операции ----------

Функция ДобавитьОбъект(ОбъектМД, Реквизиты)
	
	Если ТипЗнч(Реквизиты) <> Тип("Соответствие") Или Реквизиты.Количество() = 0 Тогда
		Возврат "Не переданы реквизиты для добавления.";
	КонецЕсли;
	
	Попытка
		Если Метаданные.Справочники.Содержит(ОбъектМД) Тогда
			НовыйЭлемент = Справочники[ОбъектМД.Имя].СоздатьЭлемент();
		ИначеЕсли Метаданные.Документы.Содержит(ОбъектМД) Тогда
			НовыйЭлемент = Документы[ОбъектМД.Имя].СоздатьДокумент();
			НовыйЭлемент.Дата = ТекущаяДатаСеанса();
		ИначеЕсли Метаданные.РегистрыСведений.Содержит(ОбъектМД) Тогда
			Возврат ДобавитьЗаписьРегистра(ОбъектМД, Реквизиты);
		ИначеЕсли Метаданные.РегистрыНакопления.Содержит(ОбъектМД) Тогда
			Возврат "Прямая запись в регистр накопления «" + ОбъектМД.Имя + "» запрещена платформой. Создайте соответствующий документ.";
		Иначе
			Возврат "Добавление для объекта «" + ОбъектМД.ПолноеИмя() + "» не поддерживается.";
		КонецЕсли;
		
		ОшибкиПолей = ЗаполнитьРеквизиты(НовыйЭлемент, ОбъектМД, Реквизиты);
		НовыйЭлемент.Записать();
		
		ЗаписьЖурналаРегистрации("ИИ_Агент.СозданиеОбъекта", УровеньЖурналаРегистрации.Информация, НовыйЭлемент.Ссылка, , "Создано через AI-чат: " + ОбъектМД.ПолноеИмя());
		
		ТекстОтвета = "✅ Создан объект <b>" + ОбъектМД.ПолноеИмя() + "</b> (" + Строка(НовыйЭлемент.Ссылка) + ")." + Символы.ПС
			+ "Заполнено: " + ОписатьРеквизиты(Реквизиты) + ".";
		
		Если ОшибкиПолей.Количество() > 0 Тогда
			ТекстОтвета = ТекстОтвета + Символы.ПС + "⚠️ Не удалось заполнить поля: " + СтрСоединить(ОшибкиПолей, "; ");
		КонецЕсли;
		
		Возврат ТекстОтвета;
	Исключение
		Возврат "Ошибка добавления: " + ТекстОшибкиДляЖурнала(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции


Функция ОбновитьОбъект(ОбъектМД, Отбор, Реквизиты)
	
	Если ТипЗнч(Реквизиты) <> Тип("Соответствие") Или Реквизиты.Количество() = 0 Тогда
		Возврат "Не указано, какие данные обновить.";
	КонецЕсли;
	
	Если Метаданные.РегистрыСведений.Содержит(ОбъектМД) Тогда
		Возврат ДобавитьЗаписьРегистра(ОбъектМД, Реквизиты, Отбор);
	КонецЕсли;
	
	Ссылка = НайтиОбъектПоОтбору(ОбъектМД, Отбор);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "Объект «" + ОбъектМД.ПолноеИмя() + "» по заданному отбору не найден.";
	КонецЕсли;
	
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		ОшибкиПолей = ЗаполнитьРеквизиты(Объект, ОбъектМД, Реквизиты);
		Объект.Записать();
		
		ЗаписьЖурналаРегистрации("ИИ_Агент.ОбновлениеОбъекта", УровеньЖурналаРегистрации.Информация, Ссылка, , "Обновлено через AI-чат: " + ОбъектМД.ПолноеИмя());
		
		ТекстОтвета = "✅ Обновлён объект <b>" + ОбъектМД.ПолноеИмя() + "</b> (" + Строка(Ссылка) + ")." + Символы.ПС
			+ "Изменено: " + ОписатьРеквизиты(Реквизиты) + ".";
			
		Если ОшибкиПолей.Количество() > 0 Тогда
			ТекстОтвета = ТекстОтвета + Символы.ПС + "⚠️ Не удалось обновить поля: " + СтрСоединить(ОшибкиПолей, "; ");
		КонецЕсли;
		
		Возврат ТекстОтвета;
	Исключение
		Возврат "Ошибка обновления: " + ТекстОшибкиДляЖурнала(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции


Функция УдалитьОбъект(ОбъектМД, Отбор)
	
	Если Метаданные.РегистрыСведений.Содержит(ОбъектМД) Тогда
		Возврат УдалитьЗаписиРегистра(ОбъектМД, Отбор);
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(ОбъектМД) Тогда
		Возврат "Прямое удаление записей из регистра накопления «" + ОбъектМД.Имя + "» запрещено. Пометьте на удаление документ-регистратор.";
	КонецЕсли;
	
	Ссылка = НайтиОбъектПоОтбору(ОбъектМД, Отбор);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "Объект «" + ОбъектМД.ПолноеИмя() + "» по заданному отбору не найден.";
	КонецЕсли;
	
	Попытка
		Если Метаданные.Справочники.Содержит(ОбъектМД) Или Метаданные.Документы.Содержит(ОбъектМД) Тогда
			Объект = Ссылка.ПолучитьОбъект();
			Объект.УстановитьПометкуУдаления(Истина);
			ЗаписьЖурналаРегистрации("ИИ_Агент.ПометкаУдаления", УровеньЖурналаРегистрации.Информация, Ссылка, , "Помечено на удаление через AI-чат: " + ОбъектМД.ПолноеИмя());
			Возврат "🗑 Объект <b>" + ОбъектМД.ПолноеИмя() + "</b> (" + Строка(Ссылка) + ") помечен на удаление.";
		Иначе
			Возврат "Удаление для объекта «" + ОбъектМД.ПолноеИмя() + "» не поддерживается.";
		КонецЕсли;
	Исключение
		Возврат "Ошибка удаления: " + ТекстОшибкиДляЖурнала(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции


// ---------- Вспомогательные функции универсальных операций ----------

Функция ЗаполнитьРеквизиты(Объект, ОбъектМД, Реквизиты)
	
	Ошибки = Новый Массив;
	
	Для Каждого Пара Из Реквизиты Цикл
		ИмяРекв = Пара.Ключ;
		Значение = Пара.Значение;
		
		// Пропускаем служебные поля
		Если ИмяРекв = "Ссылка" Или ИмяРекв = "Код" Или ИмяРекв = "Номер" Или ИмяРекв = "Проведен" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не РеквизитСуществуетВМетаданных(ОбъектМД, ИмяРекв) Тогда
			Ошибки.Добавить("реквизит «" + ИмяРекв + "» не найден");
			Продолжить;
		КонецЕсли;
		
		Попытка
			Приведённое = ПривестиЗначениеКТипу(Значение, ОбъектМД, ИмяРекв);
			Объект[ИмяРекв] = Приведённое;
		Исключение
			Ошибки.Добавить(ИмяРекв + " (" + ОписаниеОшибки() + ")");
		КонецПопытки;
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

Функция ПривестиЗначениеКТипу(Значение, ОбъектМД, ИмяРекв)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Реквизит = НайтиОписаниеРеквизитаМетаданных(ОбъектМД, ИмяРекв);
	Если Реквизит = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	
	Типы = Реквизит.Тип.Типы();
	Если Типы.Количество() = 0 Тогда
		Возврат Значение;
	КонецЕсли;
	
	ПервыйТип = Типы.Получить(0);
	ИмяТипа = Строка(ПервыйТип);
	
	Если ИмяТипа = "Число" Тогда
		Возврат Число(Значение);
	ИначеЕсли ИмяТипа = "Дата" Тогда
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			Возврат ПреобразоватьДатуИзISO(Значение);
		КонецЕсли;
		Возврат Значение;
	ИначеЕсли ИмяТипа = "Булево" Тогда
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			Возврат Значение;
		КонецЕсли;
		СтрЗн = НРег(СокрЛП(Строка(Значение)));
		Возврат (СтрЗн = "true" Или СтрЗн = "истина" Или СтрЗн = "да" Или СтрЗн = "1");
	ИначеЕсли ИмяТипа = "Строка" Тогда
		Возврат Строка(Значение);
	Иначе
		ОбъектМДТипа = Метаданные.НайтиПоТипу(ПервыйТип);
		Если ОбъектМДТипа <> Неопределено Тогда
			Если Метаданные.Справочники.Содержит(ОбъектМДТипа) Тогда
				Возврат НайтиИлиСоздатьЭлементСправочника(ОбъектМДТипа, Строка(Значение));
			ИначеЕсли Метаданные.Перечисления.Содержит(ОбъектМДТипа) Тогда
				Возврат НайтиЗначениеПеречисления(ОбъектМДТипа, Строка(Значение));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции


Функция НайтиИлиСоздатьЭлементСправочника(СправочникМД, Наименование)
	
	Искомое = СокрЛП(Наименование);
	Если Не ЗначениеЗаполнено(Искомое) Тогда
		Возврат Справочники[СправочникМД.Имя].ПустаяСсылка();
	КонецЕсли;
	
	Менеджер = Справочники[СправочникМД.Имя];
	
	// Сначала ищем точное совпадение без учета регистра (в 1С НайтиПоНаименованию регистронезависим)
	Ссылка = Менеджер.НайтиПоНаименованию(Искомое, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Нормализованное = ВРег(Лев(Искомое, 1)) + НРег(Сред(Искомое, 2));
	НовыйЭлемент = Менеджер.СоздатьЭлемент();
	НовыйЭлемент.Наименование = Нормализованное;
	НовыйЭлемент.Записать();
	Возврат НовыйЭлемент.Ссылка;
	
КонецФункции

Функция НайтиОбъектПоОтбору(ОбъектМД, Отбор)
	
	Если ТипЗнч(Отбор) <> Тип("Соответствие") Или Отбор.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Индекс = 0;
	
	Для Каждого Пара Из Отбор Цикл
		Если Не РеквизитСуществуетВМетаданных(ОбъектМД, Пара.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		
		Индекс = Индекс + 1;
		ИмяПараметра = "П_" + Формат(Индекс, "ЧГ=0");
		ЗначениеОтбора = ПривестиЗначениеКТипу(Пара.Значение, ОбъектМД, Пара.Ключ);
		
		Условия.Добавить("Т." + Пара.Ключ + " = &" + ИмяПараметра);
		Запрос.УстановитьПараметр(ИмяПараметра, ЗначениеОтбора);
	КонецЦикла;
	
	Если Условия.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Метаданные.Справочники.Содержит(ОбъектМД) Тогда
		Префикс = "Справочник.";
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМД) Тогда
		Префикс = "Документ.";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ " + Префикс + ОбъектМД.Имя + " КАК Т"
		+ " ГДЕ НЕ Т.ПометкаУдаления И " + СтрСоединить(Условия, " И ");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиЗначениеПеречисления(ПеречислениеМД, ТекстЗначения)
	
	Искомое = НРег(СокрЛП(ТекстЗначения));
	Для Каждого Зн Из ПеречислениеМД.ЗначенияПеречисления Цикл
		Если НРег(Зн.Имя) = Искомое Или НРег(Зн.Синоним) = Искомое Тогда
			Возврат Перечисления[ПеречислениеМД.Имя][Зн.Имя];
		КонецЕсли;
	КонецЦикла;
	
	Возврат Перечисления[ПеречислениеМД.Имя].ПустаяСсылка();
	
КонецФункции

Функция ДобавитьЗаписьРегистра(ОбъектМД, Реквизиты, Отбор = Неопределено)
	
	Если Не Метаданные.РегистрыСведений.Содержит(ОбъектМД) Тогда
		Возврат "Поддерживается запись только в регистры сведений.";
	КонецЕсли;
	
	Если ОбъектМД.РежимЗаписи <> Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый Тогда
		Возврат "Регистр сведений «" + ОбъектМД.Имя + "» подчинен регистратору. Изменение возможно только через документ.";
	КонецЕсли;
	
	Попытка
		МенеджерЗаписи = РегистрыСведений[ОбъектМД.Имя].СоздатьМенеджерЗаписи();
		
		// Если передан отбор (при обновлении), сначала заполняем измерения из него
		Если ТипЗнч(Отбор) = Тип("Соответствие") Тогда
			ЗаполнитьРеквизиты(МенеджерЗаписи, ОбъектМД, Отбор);
			МенеджерЗаписи.Прочитать();
		КонецЕсли;
		
		ОшибкиПолей = ЗаполнитьРеквизиты(МенеджерЗаписи, ОбъектМД, Реквизиты);
		МенеджерЗаписи.Записать(Истина);
		
		ТекстОтвета = "✅ Запись в регистр <b>" + ОбъектМД.ПолноеИмя() + "</b> сохранена.";
		Если ОшибкиПолей.Количество() > 0 Тогда
			ТекстОтвета = ТекстОтвета + Символы.ПС + "⚠️ Не заполнены поля: " + СтрСоединить(ОшибкиПолей, "; ");
		КонецЕсли;
		
		Возврат ТекстОтвета;
	Исключение
		Возврат "Ошибка записи в регистр сведений: " + ТекстОшибкиДляЖурнала(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции


Функция УдалитьЗаписиРегистра(ОбъектМД, Отбор)
	
	Если Не Метаданные.РегистрыСведений.Содержит(ОбъектМД) Тогда
		Возврат "Поддерживается удаление только из регистров сведений.";
	КонецЕсли;
	
	Если ОбъектМД.РежимЗаписи <> Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый Тогда
		Возврат "Регистр сведений «" + ОбъектМД.Имя + "» подчинен регистратору.";
	КонецЕсли;
	
	Если ТипЗнч(Отбор) <> Тип("Соответствие") Или Отбор.Количество() = 0 Тогда
		Возврат "Для удаления из регистра сведений необходимо указать отбор по измерениям.";
	КонецЕсли;
	
	Попытка
		НаборЗаписей = РегистрыСведений[ОбъектМД.Имя].СоздатьНаборЗаписей();
		УстановленоОтборов = 0;
		
		Для Каждого Пара Из Отбор Цикл
			Если НаборЗаписей.Отбор.Найти(Пара.Ключ) <> Неопределено Тогда
				ЗначениеОтбора = ПривестиЗначениеКТипу(Пара.Значение, ОбъектМД, Пара.Ключ);
				НаборЗаписей.Отбор[Пара.Ключ].Установить(ЗначениеОтбора);
				УстановленоОтборов = УстановленоОтборов + 1;
			КонецЕсли;
		КонецЦикла;
		
		Если УстановленоОтборов = 0 Тогда
			Возврат "Не удалось применить ни один отбор по измерениям регистра «" + ОбъектМД.Имя + "».";
		КонецЕсли;
		
		НаборЗаписей.Записать(Истина);
		Возврат "🗑 Записи регистра <b>" + ОбъектМД.ПолноеИмя() + "</b> удалены по заданному отбору.";
	Исключение
		Возврат "Ошибка удаления записей регистра: " + ТекстОшибкиДляЖурнала(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции


Функция ОписатьРеквизиты(Реквизиты)
	
	Части = Новый Массив;
	Для Каждого Пара Из Реквизиты Цикл
		Части.Добавить(Пара.Ключ + "=" + Строка(Пара.Значение));
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СобратьКонтекстИзБазы(План)
	
	СтрокиОтчета = Новый Массив;
	ОбщаяСводка = (План.Получить("общая_сводка") = Истина);
	
	Если ОбщаяСводка Или План.Получить("виды_животных") = Истина Тогда
		СтрокиОтчета.Добавить(ПолучитьДанныеПоВидамЖивотных());
	КонецЕсли;
	
	Если ОбщаяСводка Или План.Получить("животные_список") = Истина Или План.Получить("виды_животных") = Истина Тогда
		СтрокиОтчета.Добавить(ПолучитьСписокЖивотных());
	КонецЕсли;
	
	Если ОбщаяСводка Или План.Получить("поголовье") = Истина Тогда
		СтрокиОтчета.Добавить(ПолучитьОстаткиПоголовья());
	КонецЕсли;
	
	Если ОбщаяСводка Или План.Получить("корма") = Истина Тогда
		СтрокиОтчета.Добавить(ПолучитьСтатистикуКормов());
	КонецЕсли;
	
	Если ОбщаяСводка Или План.Получить("продукция") = Истина Тогда
		СтрокиОтчета.Добавить(ПолучитьСтатистикуПродукции());
	КонецЕсли;
	
	Если СтрокиОтчета.Количество() = 0 Тогда
		СтрокиОтчета.Добавить(ПолучитьДанныеПоВидамЖивотных());
		СтрокиОтчета.Добавить(ПолучитьСписокЖивотных());
		СтрокиОтчета.Добавить(ПолучитьОстаткиПоголовья());
	КонецЕсли;
	
	Возврат СтрСоединить(СтрокиОтчета, Символы.ПС + Символы.ПС);
	
КонецФункции

// ... (функции ПолучитьДанныеПоВидамЖивотных, ПолучитьСписокЖивотных,
//      ПолучитьОстаткиПоголовья, ПолучитьСтатистикуКормов,
//      ПолучитьСтатистикуПродукции, ТекстОшибкиДляЖурнала — без изменений)
Функция ПолучитьДанныеПоВидамЖивотных()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыЖивотных.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ВидыЖивотных КАК ВидыЖивотных
		|ГДЕ
		|	НЕ ВидыЖивотных.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Список = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Список.Добавить("- " + Выборка.Наименование);
	КонецЦикла;
	Если Список.Количество() = 0 Тогда
		Возврат "=== ВИДЫ ЖИВОТНЫХ === Справочник 'Виды животных' пуст.";
	КонецЕсли;
	Возврат "=== ВИДЫ ЖИВОТНЫХ В СПРАВОЧНИКЕ (" + Список.Количество() + " шт.) ===" + Символы.ПС + СтрСоединить(Список, Символы.ПС);
	
КонецФункции

Функция ПолучитьСписокЖивотных()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	Животные.Наименование КАК Наименование,
		|	Животные.ВидЖивотного КАК ВидЖивотного,
		|	Животные.Пол КАК Пол,
		|	Животные.Вес КАК Вес,
		|	Животные.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	Животные.ДатаРождения КАК ДатаРождения
		|ИЗ
		|	Справочник.Животные КАК Животные
		|ГДЕ
		|	НЕ Животные.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидЖивотного,
		|	Наименование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Список = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Описание = "- " + Выборка.Наименование;
		Если ЗначениеЗаполнено(Выборка.ВидЖивотного) Тогда
			Описание = Описание + " (вид: " + Строка(Выборка.ВидЖивотного) + ")";
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Пол) Тогда
			Описание = Описание + ", пол: " + Строка(Выборка.Пол);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Вес) Тогда
			Описание = Описание + ", вес: " + Выборка.Вес + " кг";
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ИнвентарныйНомер) Тогда
			Описание = Описание + ", инв.№: " + Выборка.ИнвентарныйНомер;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ДатаРождения) Тогда
			Описание = Описание + ", дата рожд.: " + Формат(Выборка.ДатаРождения, "ДЛФ=Д");
		КонецЕсли;
		Список.Добавить(Описание);
	КонецЦикла;
	Если Список.Количество() = 0 Тогда
		Возврат "=== КАРТОТЕКА ЖИВОТНЫХ === Справочник 'Животные' пуст.";
	КонецЕсли;
	Возврат "=== КАРТОТЕКА ЖИВОТНЫХ (" + Список.Количество() + " шт.) ===" + Символы.ПС + СтрСоединить(Список, Символы.ПС);
	
КонецФункции

Функция ПолучитьОстаткиПоголовья()
	
	МДРегистра = Метаданные.РегистрыНакопления.Поголовье;
	Если МДРегистра.Измерения.Количество() = 0 Или МДРегистра.Ресурсы.Количество() = 0 Тогда
		Возврат "=== ТЕКУЩЕЕ ПОГОЛОВЬЕ === В регистре Поголовье не найдены измерения или ресурсы.";
	КонецЕсли;
	
	ПоляВыборки = Новый Массив;
	ПоляГруппировки = Новый Массив;
	ИменаИзмерений = Новый Массив;
	ИменаРесурсов = Новый Массив;
	
	Для Каждого Изм Из МДРегистра.Измерения Цикл
		ПоляВыборки.Добавить("Остатки." + Изм.Имя + " КАК " + Изм.Имя);
		ПоляГруппировки.Добавить("Остатки." + Изм.Имя);
		ИменаИзмерений.Добавить(Изм.Имя);
	КонецЦикла;
	
	Для Каждого Рес Из МДРегистра.Ресурсы Цикл
		ПоляВыборки.Добавить("СУММА(Остатки." + Рес.Имя + "Остаток) КАК " + Рес.Имя);
		ИменаРесурсов.Добавить(Рес.Имя);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	" + СтрСоединить(ПоляВыборки, "," + Символы.ПС + "	") + "
		|ИЗ
		|	РегистрНакопления.Поголовье.Остатки КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	" + СтрСоединить(ПоляГруппировки, "," + Символы.ПС + "	");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Список = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ЧастиИзмерений = Новый Массив;
		Для Каждого ИмяИзм Из ИменаИзмерений Цикл
			ЧастиИзмерений.Добавить(Строка(Выборка[ИмяИзм]));
		КонецЦикла;
		
		ЧастиРесурсов = Новый Массив;
		Для Каждого ИмяРес Из ИменаРесурсов Цикл
			ЧастиРесурсов.Добавить(ИмяРес + ": " + Выборка[ИмяРес]);
		КонецЦикла;
		
		Список.Добавить("- " + СтрСоединить(ЧастиИзмерений, " / ") + " -> " + СтрСоединить(ЧастиРесурсов, ", "));
	КонецЦикла;
	
	Если Список.Количество() = 0 Тогда
		Возврат "=== ТЕКУЩЕЕ ПОГОЛОВЬЕ === По данным регистра остатков животных сейчас нет.";
	КонецЕсли;
	Возврат "=== ТЕКУЩЕЕ ПОГОЛОВЬЕ НА ФЕРМЕ (" + Список.Количество() + " поз.) ===" + Символы.ПС + СтрСоединить(Список, Символы.ПС);
	
КонецФункции


Функция ПолучитьСтатистикуКормов()
	
	МДРегистра = Метаданные.РегистрыНакопления.РасходКормов;
	Если МДРегистра.Измерения.Количество() = 0 Или МДРегистра.Ресурсы.Количество() = 0 Тогда
		Возврат "=== РАСХОД КОРМОВ === В регистре РасходКормов не найдены измерения или ресурсы.";
	КонецЕсли;
	
	ПоляВыборки = Новый Массив;
	ПоляГруппировки = Новый Массив;
	ИменаИзмерений = Новый Массив;
	ИменаРесурсов = Новый Массив;
	
	Для Каждого Изм Из МДРегистра.Измерения Цикл
		ПоляВыборки.Добавить("Обороты." + Изм.Имя + " КАК " + Изм.Имя);
		ПоляГруппировки.Добавить("Обороты." + Изм.Имя);
		ИменаИзмерений.Добавить(Изм.Имя);
	КонецЦикла;
	
	Для Каждого Рес Из МДРегистра.Ресурсы Цикл
		ПоляВыборки.Добавить("СУММА(Обороты." + Рес.Имя + "Оборот) КАК " + Рес.Имя);
		ИменаРесурсов.Добавить(Рес.Имя);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	" + СтрСоединить(ПоляВыборки, "," + Символы.ПС + "	") + "
		|ИЗ
		|	РегистрНакопления.РасходКормов.Обороты(&ДатаНач, &ДатаКон) КАК Обороты
		|
		|СГРУППИРОВАТЬ ПО
		|	" + СтрСоединить(ПоляГруппировки, "," + Символы.ПС + "	");
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ТекущаяДатаСеанса() - 30 * 86400));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ТекущаяДатаСеанса()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Список = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ЧастиИзмерений = Новый Массив;
		Для Каждого ИмяИзм Из ИменаИзмерений Цикл
			ЧастиИзмерений.Добавить(Строка(Выборка[ИмяИзм]));
		КонецЦикла;
		
		ЧастиРесурсов = Новый Массив;
		Для Каждого ИмяРес Из ИменаРесурсов Цикл
			ЧастиРесурсов.Добавить(ИмяРес + ": " + Выборка[ИмяРес]);
		КонецЦикла;
		
		Список.Добавить("- " + СтрСоединить(ЧастиИзмерений, " / ") + " -> " + СтрСоединить(ЧастиРесурсов, ", "));
	КонецЦикла;
	
	Если Список.Количество() = 0 Тогда
		Возврат "=== РАСХОД КОРМОВ (ЗА 30 ДНЕЙ) === Расхода кормов за последний месяц не зафиксировано.";
	КонецЕсли;
	Возврат "=== РАСХОД КОРМОВ ЗА ПОСЛЕДНИЕ 30 ДНЕЙ ===" + Символы.ПС + СтрСоединить(Список, Символы.ПС);
	
КонецФункции


