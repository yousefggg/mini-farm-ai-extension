		|ИЗ
		|	РегистрНакопления.ВыработкаПродукции.Обороты(&ДатаНач, &ДатаКон) КАК Обороты
		|
		|СГРУППИРОВАТЬ ПО
		|	" + СтрСоединить(ПоляГруппировки, "," + Символы.ПС + "	");
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ТекущаяДатаСеанса() - 30 * 86400));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ТекущаяДатаСеанса()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Список = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ЧастиИзмерений = Новый Массив;
		Для Каждого ИмяИзм Из ИменаИзмерений Цикл
			ЧастиИзмерений.Добавить(Строка(Выборка[ИмяИзм]));
		КонецЦикла;
		
		ЧастиРесурсов = Новый Массив;
		Для Каждого ИмяРес Из ИменаРесурсов Цикл
			ЧастиРесурсов.Добавить(ИмяРес + ": " + Выборка[ИмяРес]);
		КонецЦикла;
		
		Список.Добавить("- " + СтрСоединить(ЧастиИзмерений, " / ") + " -> " + СтрСоединить(ЧастиРесурсов, ", "));
	КонецЦикла;
	
	Если Список.Количество() = 0 Тогда
		Возврат "=== ВЫРАБОТКА ПРОДУКЦИИ (ЗА 30 ДНЕЙ) === Выработки продукции за последний месяц не зафиксировано.";
	КонецЕсли;
	Возврат "=== ВЫРАБОТКА ПРОДУКЦИИ ЗА ПОСЛЕДНИЕ 30 ДНЕЙ ===" + Символы.ПС + СтрСоединить(Список, Символы.ПС);
	
КонецФункции


// Формирует подробный текст ошибки из ИнформацияОбОшибке, включая вложенные причины.
Функция ТекстОшибкиДляЖурнала(ИнфоОбОшибке)
	
	Если ИнфоОбОшибке = Неопределено Тогда
		Возврат "Неизвестная ошибка";
	КонецЕсли;
	
	Текст = ИнфоОбОшибке.Описание;
	
	Если ЗначениеЗаполнено(ИнфоОбОшибке.ИмяМодуля) Тогда
		Текст = Текст + Символы.ПС + "Модуль: " + ИнфоОбОшибке.ИмяМодуля
			+ ", строка " + Формат(ИнфоОбОшибке.НомерСтроки, "ЧГ=0");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнфоОбОшибке.ИсходнаяСтрока) Тогда
		Текст = Текст + Символы.ПС + "Код: " + СокрЛП(ИнфоОбОшибке.ИсходнаяСтрока);
	КонецЕсли;
	
	Если ИнфоОбОшибке.Причина <> Неопределено Тогда
		Текст = Текст + Символы.ПС + "Причина: " + ТекстОшибкиДляЖурнала(ИнфоОбОшибке.Причина);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция ПолучитьКартуКонфигурации() Экспорт
	
	Описание = Новый Массив;
	
	// 1. Справочники
	Описание.Добавить("=== СПРАВОЧНИКИ ===");
	Для Каждого Спр Из Метаданные.Справочники Цикл
		Если СтрНачинаетсяС(Спр.Имя, "ИИ_") Тогда
			Продолжить;
		КонецЕсли;
		
		Поля = Новый Массив;
		Если Спр.ДлинаКода > 0 Тогда
			Поля.Добавить("Код");
		КонецЕсли;
		Если Спр.ДлинаНаименования > 0 Тогда
			Поля.Добавить("Наименование");
		КонецЕсли;
		Если Спр.Иерархический Тогда
			Поля.Добавить("Родитель (Справочник." + Спр.Имя + ")");
		КонецЕсли;
		
		Для Каждого Р Из Спр.Реквизиты Цикл
			Поля.Добавить(Р.Имя + " (" + ОписаниеТиповСтрокой(Р.Тип) + ")");
		КонецЦикла;
		
		Описание.Добавить("- Справочник." + Спр.Имя + " [" + Спр.Синоним + "]: " + СтрСоединить(Поля, ", "));
	КонецЦикла;
	
	// 2. Перечисления
	Если Метаданные.Перечисления.Количество() > 0 Тогда
		Описание.Добавить("");
		Описание.Добавить("=== ПЕРЕЧИСЛЕНИЯ ===");
		Для Каждого Переч Из Метаданные.Перечисления Цикл
			Если СтрНачинаетсяС(Переч.Имя, "ИИ_") Тогда
				Продолжить;
			КонецЕсли;
			ЗначенияПеречисления = Новый Массив;
			Для Каждого З Из Переч.ЗначенияПеречисления Цикл
				ЗначенияПеречисления.Добавить(З.Имя);
			КонецЦикла;
			Описание.Добавить("- Перечисление." + Переч.Имя + ": " + СтрСоединить(ЗначенияПеречисления, ", "));
		КонецЦикла;
	КонецЕсли;
	
	// 3. Документы и их табличные части
	Описание.Добавить("");
	Описание.Добавить("=== ДОКУМЕНТЫ ===");
	Для Каждого Док Из Метаданные.Документы Цикл
		Если СтрНачинаетсяС(Док.Имя, "ИИ_") Тогда
			Продолжить;
		КонецЕсли;
		
		Поля = Новый Массив;
		Поля.Добавить("Номер");
		Поля.Добавить("Дата");
		Поля.Добавить("Проведен");
		
		Для Каждого Р Из Док.Реквизиты Цикл
			Поля.Добавить(Р.Имя + " (" + ОписаниеТиповСтрокой(Р.Тип) + ")");
		КонецЦикла;
		
		Описание.Добавить("- Документ." + Док.Имя + " [" + Док.Синоним + "]: " + СтрСоединить(Поля, ", "));
		
		Для Каждого ТЧ Из Док.ТабличныеЧасти Цикл
			РеквТЧ = Новый Массив;
			Для Каждого РТЧ Из ТЧ.Реквизиты Цикл
				РеквТЧ.Добавить(РТЧ.Имя + " (" + ОписаниеТиповСтрокой(РТЧ.Тип) + ")");
			КонецЦикла;
			Описание.Добавить("   * ТабЧасть." + ТЧ.Имя + ": " + СтрСоединить(РеквТЧ, ", "));
		КонецЦикла;
	КонецЦикла;
	
	// 4. Регистры накопления
	Описание.Добавить("");
	Описание.Добавить("=== РЕГИСТРЫ НАКОПЛЕНИЯ ===");
	Для Каждого Рег Из Метаданные.РегистрыНакопления Цикл
		Если СтрНачинаетсяС(Рег.Имя, "ИИ_") Тогда
			Продолжить;
		КонецЕсли;
		
		Изм = Новый Массив;
		Для Каждого Измер Из Рег.Измерения Цикл
			Изм.Добавить(Измер.Имя + " (" + ОписаниеТиповСтрокой(Измер.Тип) + ")");
		КонецЦикла;
		
		Рес = Новый Массив;
		Для Каждого Р Из Рег.Ресурсы Цикл
			Рес.Добавить(Р.Имя + " (" + ОписаниеТиповСтрокой(Р.Тип) + ")");
		КонецЦикла;
		
		Описание.Добавить("- РегистрНакопления." + Рег.Имя + " (Вид: " + Строка(Рег.ВидРегистра) + ") | Измерения: "
			+ СтрСоединить(Изм, ", ") + " | Ресурсы: " + СтрСоединить(Рес, ", "));
	КонецЦикла;
	
	// 5. Регистры сведений
	Если Метаданные.РегистрыСведений.Количество() > 0 Тогда
		Описание.Добавить("");
		Описание.Добавить("=== РЕГИСТРЫ СВЕДЕНИЙ ===");
		Для Каждого Рег Из Метаданные.РегистрыСведений Цикл
			Если СтрНачинаетсяС(Рег.Имя, "ИИ_") Тогда
				Продолжить;
			КонецЕсли;
			
			Изм = Новый Массив;
			Для Каждого Измер Из Рег.Измерения Цикл
				Изм.Добавить(Измер.Имя + " (" + ОписаниеТиповСтрокой(Измер.Тип) + ")");
			КонецЦикла;
			
			Рес = Новый Массив;
			Для Каждого Р Из Рег.Ресурсы Цикл
				Рес.Добавить(Р.Имя + " (" + ОписаниеТиповСтрокой(Р.Тип) + ")");
			КонецЦикла;
			
			Описание.Добавить("- РегистрСведений." + Рег.Имя + " (Режим: " + Строка(Рег.РежимЗаписи) + ") | Измерения: "
				+ СтрСоединить(Изм, ", ") + " | Ресурсы: " + СтрСоединить(Рес, ", "));
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтрСоединить(Описание, Символы.ПС);
	
КонецФункции


Функция ОписаниеТиповСтрокой(ОписаниеТипов)
	
	Имена = Новый Массив;
	Для Каждого Т Из ОписаниеТипов.Типы() Цикл
		ОбъектМД = Метаданные.НайтиПоТипу(Т);
		Если ОбъектМД <> Неопределено Тогда
			Имена.Добавить(ОбъектМД.ПолноеИмя());
		Иначе
			Имена.Добавить(Строка(Т));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Имена, "/");
	
КонецФункции

Функция ПреобразоватьДатуИзISO(ДатаСтрокой)
	
	Стр = СокрЛП(ДатаСтрокой);
	Если Не ЗначениеЗаполнено(Стр) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Если СтрДлина(Стр) = 10 Тогда
		Стр = Стр + "T00:00:00";
	КонецЕсли;
	
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Стр);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
	
КонецФункции

Функция РеквизитСуществуетВМетаданных(ОбъектМД, ИмяРекв)
	Возврат НайтиОписаниеРеквизитаМетаданных(ОбъектМД, ИмяРекв) <> Неопределено;
КонецФункции
Функция НайтиОписаниеРеквизитаМетаданных(ОбъектМД, ИмяРекв)

	
	Для Каждого Р Из ОбъектМД.Реквизиты Цикл
		Если ВРег(Р.Имя) = ВРег(ИмяРекв) Тогда
			Возврат Р;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтР Из ОбъектМД.СтандартныеРеквизиты Цикл
		Если ВРег(СтР.Имя) = ВРег(ИмяРекв) Тогда
			Возврат СтР;
		КонецЕсли;
	КонецЦикла;
	
	Если Метаданные.РегистрыСведений.Содержит(ОбъектМД) Или Метаданные.РегистрыНакопления.Содержит(ОбъектМД) Тогда
		Для Каждого Изм Из ОбъектМД.Измерения Цикл
			Если ВРег(Изм.Имя) = ВРег(ИмяРекв) Тогда
				Возврат Изм;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Рес Из ОбъектМД.Ресурсы Цикл
			Если ВРег(Рес.Имя) = ВРег(ИмяРекв) Тогда
				Возврат Рес;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти