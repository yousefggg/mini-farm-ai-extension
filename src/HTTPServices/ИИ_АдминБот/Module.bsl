#Область ОбработчикиЗапросов

// POST /hs/ai_admin/auth
// Ожидает JSON: {"key": "секретный_ключ", "chat_id": 123456789}
Функция authPOST(Запрос)
	
	Данные = ПрочитатьТелоJSON(Запрос);
	Если Данные = Неопределено Тогда
		Возврат СформироватьОтветJSON(400, Ложь, "", "Некорректный формат JSON.");
	КонецЕсли;
	
	Ключ = ПолучитьСтроку(Данные, "key", МаксДлинаКлюча());
	ChatID = Данные.Получить("chat_id");
	
	Если Ключ = Неопределено Или Не ЧатИДКорректен(ChatID) Тогда
		Возврат СформироватьОтветJSON(400, Ложь, "", "Не передан ключ (key) или chat_id.");
	КонецЕсли;
	
	ХэшКлюча = ХэшКлюча(Ключ);
	
	Результат = ПроверитьИПривязатьКлюч(ХэшКлюча, ChatID);
	
	Если Не Результат.Успех Тогда
		ЗаписьЖурналаРегистрации("ИИ_АдминБот.Авторизация",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			Результат.Причина + " chat_id=" + Формат(ChatID, "ЧГ=0") + ", ключ#" + Лев(ХэшКлюча, 8));
		Возврат СформироватьОтветJSON(401, Ложь, "", "Доступ запрещён.");
	КонецЕсли;
	
	Возврат СформироватьОтветJSON(200, Истина,
		"Авторизация успешна! Ваш уровень доступа: " + Результат.ИмяРоли);
	
КонецФункции

// POST /hs/ai_admin/command
// Заголовок: X-Api-Key: <секретный_ключ>
// Ожидает JSON: {"chat_id": 123456789, "text": "Покажи остатки кормов"}
Функция commandPOST(Запрос)
	
	Ключ = "";
	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = "x-api-key" Тогда
			Ключ = СокрЛП(Строка(Заголовок.Значение));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Возврат СформироватьОтветJSON(401, Ложь, "", "Отсутствует заголовок X-Api-Key.");
	КонецЕсли;
	
	Данные = ПрочитатьТелоJSON(Запрос);
	Если Данные = Неопределено Тогда
		Возврат СформироватьОтветJSON(400, Ложь, "", "Некорректный формат JSON.");
	КонецЕсли;
	
	ChatID = Данные.Получить("chat_id");
	ТекстКоманды = СокрЛП(Строка(Данные.Получить("text")));
	
	Если Не ЗначениеЗаполнено(ТекстКоманды) Тогда
		Возврат СформироватьОтветJSON(400, Ложь, "", "Пустой текст команды.");
	КонецЕсли;
	
	Проверка = ПроверитьДоступ(Ключ, ChatID);
	Если Не Проверка.Разрешено Тогда
		Возврат СформироватьОтветJSON(403, Ложь, "", Проверка.Причина);
	КонецЕсли;
	
	РезультатИИ = ИИ_АналитикаФермыСервер.ОтветитьНаВопросПоБазе(ТекстКоманды, Проверка.ТолькоЧтение);
	
	Если РезультатИИ.Успех Тогда
		Возврат СформироватьОтветJSON(200, Истина, РезультатИИ.Текст);
	Иначе
		Возврат СформироватьОтветJSON(200, Ложь, "", РезультатИИ.Ошибка);
	КонецЕсли;
	
КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьИПривязатьКлюч(ХэшКлюча, ChatID)
	
	Результат = Новый Структура("Успех, Причина, ИмяРоли", Ложь, "", "");
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ИИ_КлючиДоступа");
		Элемент.УстановитьЗначение("КлючДоступа", ХэшКлюча);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		НаборЗаписей = РегистрыСведений.ИИ_КлючиДоступа.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.КлючДоступа.Установить(ХэшКлюча);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			Результат.Причина = "Ключ не найден.";
		Иначе
			ЗаписьРегистра = НаборЗаписей[0];
			
			Если Не ЗаписьРегистра.Активен Тогда
				Результат.Причина = "Ключ заблокирован.";
			ИначеЕсли ЗаписьРегистра.TelegramID = 0 Тогда
				ЗаписьРегистра.TelegramID = ChatID;
				НаборЗаписей.Записать();
				Результат.Успех = Истина;
				Результат.ИмяРоли = Строка(ЗаписьРегистра.УровеньДоступа);
				ЗаписьЖурналаРегистрации("ИИ_АдминБот.ПривязкаКлюча",
					УровеньЖурналаРегистрации.Информация, , ,
					"Ключ#" + Лев(ХэшКлюча, 8) + " привязан к TelegramID: " + Формат(ChatID, "ЧГ=0"));
			ИначеЕсли ЗаписьРегистра.TelegramID <> ChatID Тогда
				Результат.Причина = "Ключ привязан к другому TelegramID.";
			Иначе
				Результат.Успех = Истина;
				Результат.ИмяРоли = Строка(ЗаписьРегистра.УровеньДоступа);
			КонецЕсли;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("ИИ_АдминБот.Авторизация",
			УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстОшибкиДляЖурнала(ИнформацияОбОшибке()));
		Результат.Успех = Ложь;
		Результат.Причина = "Ошибка при проверке ключа.";
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьДоступ(Ключ, ChatID)
	
	Результат = Новый Структура("Разрешено, ТолькоЧтение, Причина", Ложь, Истина, "");
	
	Отбор = Новый Структура("КлючДоступа", Ключ);
	ДанныеКлюча = РегистрыСведений.ИИ_КлючиДоступа.Получить(Отбор);
	
	Если Не ЗначениеЗаполнено(ДанныеКлюча.УровеньДоступа) Тогда
		Результат.Причина = "Ключ '" + Ключ + "' не найден в регистре ИИ_КлючиДоступа.";
		Возврат Результат;
	КонецЕсли;
	
	Если Не ДанныеКлюча.Активен Тогда
		Результат.Причина = "Ключ отключен (Активен = Ложь).";
		Возврат Результат;
	КонецЕсли;
	
	Если ДанныеКлюча.TelegramID <> 0 И ТипЗнч(ChatID) = Тип("Число") И ДанныеКлюча.TelegramID <> ChatID Тогда
		Результат.Причина = "Ключ привязан к другому TelegramID (" + ДанныеКлюча.TelegramID + ").";
		Возврат Результат;
	КонецЕсли;
	
	Результат.Разрешено = Истина;
	Результат.ТолькоЧтение = (ДанныеКлюча.УровеньДоступа = Перечисления.ИИ_УровниДоступа.ТолькоЧтение);
	
	Возврат Результат;
	
КонецФункции

// SHA-256 от ключа, hex в верхнем регистре.
// В регистре ИИ_КлючиДоступа должен храниться именно хэш (нужна миграция существующих ключей).
Функция ХэшКлюча(Ключ)
	
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Ключ);
	Возврат ВРег(СтрЗаменить(Строка(Хеширование.ХешСумма), " ", ""));
	
КонецФункции

Функция ПолучитьСтроку(Данные, Имя, МаксДлина)
	
	Значение = Данные.Получить(Имя);
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Значение = СокрЛП(Значение);
	Если Значение = "" Или СтрДлина(Значение) > МаксДлина Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ПолучитьЗаголовок(Запрос, Имя)
	
	Для Каждого Элемент Из Запрос.Заголовки Цикл
		Если НРег(Элемент.Ключ) = НРег(Имя) И ТипЗнч(Элемент.Значение) = Тип("Строка") Тогда
			Значение = СокрЛП(Элемент.Значение);
			Возврат ?(Значение = "", Неопределено, Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЧатИДКорректен(ChatID)
	
	Возврат ТипЗнч(ChatID) = Тип("Число") И ChatID <> 0 И Цел(ChatID) = ChatID;
	
КонецФункции

Функция МаксДлинаКлюча()
	Возврат 256;
КонецФункции

Функция МаксДлинаКоманды()
	Возврат 4000;
КонецФункции

// Возвращает Соответствие или Неопределено, если тело пустое/не JSON-объект.
Функция ПрочитатьТелоJSON(Запрос)
	
	Чтение = Неопределено;
	Попытка
		ТелоСтрокой = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Если Не ЗначениеЗаполнено(ТелоСтрокой) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоСтрокой);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Чтение = Неопределено;
	Исключение
		Если Чтение <> Неопределено Тогда
			Попытка
				Чтение.Закрыть();
			Исключение
			КонецПопытки;
		КонецЕсли;
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

Функция СформироватьОтветJSON(КодСостояния, Успех, ТекстОтвета = "", ТекстОшибки = "")
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ok", Успех);
	СтруктураОтвета.Вставить("reply", ТекстОтвета);
	СтруктураОтвета.Вставить("error", ТекстОшибки);
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, СтруктураОтвета);
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть());
	
	Возврат Ответ;
	
КонецФункции
Функция ТекстОшибкиДляЖурнала(ИнфоОбОшибке)
	
	Текст = ИнфоОбОшибке.Описание;
	
	Если ЗначениеЗаполнено(ИнфоОбОшибке.ИмяМодуля) Тогда
		Текст = Текст + Символы.ПС + "Модуль: " + ИнфоОбОшибке.ИмяМодуля
			+ ", строка " + Формат(ИнфоОбОшибке.НомерСтроки, "ЧГ=0");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнфоОбОшибке.ИсходнаяСтрока) Тогда
		Текст = Текст + Символы.ПС + "Код: " + СокрЛП(ИнфоОбОшибке.ИсходнаяСтрока);
	КонецЕсли;
	
	Если ИнфоОбОшибке.Причина <> Неопределено Тогда
		Текст = Текст + Символы.ПС + "Причина: " + ТекстОшибкиДляЖурнала(ИнфоОбОшибке.Причина);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции


#КонецОбласти